# AI provider configuration
# Supported providers: "heuristic" (no API key needed, built-in rule engine) | "anthropic"
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

# Database (SQLite by default; point DATABASE_URL at Postgres for production)
DATABASE_URL="file:./dev.db"

# Rate limiting
ANALYZE_RATE_LIMIT_PER_MINUTE=20

# Auth (NextAuth.js)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials
# with authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of email addresses granted access to /admin (the
# registered-users list). Case-insensitive. Leave blank to disable the page
# for everyone.
ADMIN_EMAILS=
