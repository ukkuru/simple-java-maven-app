generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Analysis {
  id                 String   @id @default(cuid())
  title              String
  framework          String
  userStory          String
  acceptanceCriteria String
  overallScore       Int
  previousScore       Int?
  resultJson         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
